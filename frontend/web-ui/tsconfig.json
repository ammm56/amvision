{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "paths": {
      "three": ["./node_modules/@types/three"],
      "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"],
      "@lucide/vue": ["./node_modules/@lucide/vue"],
      "@litegraph/*": [
        "./src/lib/litegraph/src/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "vue": [
        "./node_modules/vue"
      ],
      "vue-i18n": [
        "./node_modules/vue-i18n"
      ],
      "vue-router": [
        "./node_modules/vue-router"
      ],
      "pinia": [
        "./node_modules/pinia"
      ],
      "vitest": [
        "./node_modules/vitest"
      ],
      "@vue/test-utils": [
        "./node_modules/@vue/test-utils"
      ],
      "reka-ui": [
        "./node_modules/reka-ui"
      ]
    },
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vitest.setup.ts",
    "../../tests/frontend/**/test_*.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
