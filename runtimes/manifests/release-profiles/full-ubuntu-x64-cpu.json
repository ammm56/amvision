  "artifacts": {
    "include_frontend": true,
    "include_tensorrt_runtime": false,
    "include_cudnn_runtime": false,
    "ffmpeg_platform": "linux-x64",
    "requirements_file": "requirements_cpu.txt",
    "requirements_exclude_packages": []
  }
}
