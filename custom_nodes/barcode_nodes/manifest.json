{
  "format_id": "amvision.node-pack-manifest.v1",
  "id": "barcode.nodes",
  "version": "0.2.0",
  "displayName": "Barcode Nodes",
  "description": "提供统一的条码和二维码解码、组合处理、筛选、摘要、绘制与结果展示节点。",
  "category": "vision",
  "categoryRoot": "barcode",
  "implementationLayout": "categories",
  "capabilities": [
    "pipeline.node",
    "barcode.decode",
    "barcode.logic",
    "barcode.render",
    "barcode.display",
    "response.body"
  ],
  "permissionScopes": [
    "objectstore.read.ref",
    "objectstore.write.ref"
  ],
  "entrypoints": {
    "backend": "custom_nodes.barcode_nodes.backend.entry:register"
  },
  "compatibility": {
    "api": ">=0.1 <1.0",
    "runtime": ">=3.12"
  },
  "timeout": {
    "defaultSeconds": 30
  },
  "enabledByDefault": true,
  "customNodeCatalogPath": "workflow/catalog.json",
  "metadata": {
    "categoryRoot": "barcode",
    "sourceLayout": "categories/<category>",
    "implementedCategories": [
      "decode",
      "compose",
      "logic",
      "render",
      "transform",
      "display"
    ]
  }
}
