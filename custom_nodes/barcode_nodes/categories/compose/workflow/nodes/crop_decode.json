    "is_pure":{"type":"boolean","default":false},
    "return_errors":{"type":"boolean","default":false}
  }},
  "capability_tags":["barcode.decode","barcode.remap"],
  "runtime_requirements":{"python_packages":["opencv-python","numpy","zxing-cpp"]},
  "node_pack_id":"barcode.nodes","node_pack_version":"0.1.8"
}
