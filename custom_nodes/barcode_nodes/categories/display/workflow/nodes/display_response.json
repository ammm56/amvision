{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.barcode.display-response",
  "display_name": "Barcode Display Response",
  "category": "barcode.display",
  "description": "把标注图片和 Barcode 结果摘要组装成适合工作站或 REST 返回的 response-body。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {
      "name": "annotated_image",
      "display_name": "Annotated Image",
      "payload_type_id": "image-ref.v1",
      "required": false
    },
    {
      "name": "results",
      "display_name": "Results",
      "payload_type_id": "barcode-results.v1",
      "required": true
    },
    {
      "name": "meta",
      "display_name": "Meta",
      "payload_type_id": "value.v1",
      "required": false
    }
  ],
  "output_ports": [
    {
      "name": "body",
      "display_name": "Body",
      "payload_type_id": "response-body.v1"
    }
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer"
      },
      "message": {
        "type": "string",
        "minLength": 1
      },
      "image_title": {
        "type": "string",
        "minLength": 1
      },
      "table_title": {
        "type": "string",
        "minLength": 1
      },
      "response_transport_mode": {
        "type": "string",
        "enum": [
          "inline-base64",
          "storage-ref"
        ]
      },
      "output_object_key": {
        "type": "string"
      }
    }
  },
  "capability_tags": [
    "barcode.display",
    "response.body"
  ],
  "runtime_requirements": {
    "python_packages": []
  },
  "node_pack_id": "barcode.nodes",
  "node_pack_version": "0.1.3"
}
