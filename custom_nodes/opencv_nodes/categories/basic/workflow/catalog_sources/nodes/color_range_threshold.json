{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.color-range-threshold",
  "display_name": "Color Range Threshold",
  "category": "opencv.image.threshold",
  "description": "在指定颜色空间按各通道上下界执行 inRange，输出二值 mask。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {
      "name": "image",
      "display_name": "Image",
      "payload_type_id": "image-ref.v1"
    }
  ],
  "output_ports": [
    {
      "name": "mask",
      "display_name": "Mask",
      "payload_type_id": "image-ref.v1"
    }
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "color_space": {
        "type": "string",
        "default": "hsv",
        "enum": [
          "bgr",
          "hsv",
          "hls",
          "lab",
          "ycrcb",
          "gray"
        ]
      },
      "lower": {
        "type": "array",
        "default": [
          0,
          0,
          0
        ],
        "items": {
          "type": "number"
        }
      },
      "upper": {
        "type": "array",
        "default": [
          179,
          255,
          255
        ],
        "items": {
          "type": "number"
        }
      },
      "invert": {
        "type": "boolean",
        "default": false
      },
      "output_object_key": {
        "type": "string"
      }
    }
  },
  "capability_tags": [
    "opencv.in-range",
    "vision.mask",
    "inspection.color"
  ],
  "runtime_requirements": {
    "python_packages": [
      "opencv-python",
      "numpy"
    ]
  },
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
