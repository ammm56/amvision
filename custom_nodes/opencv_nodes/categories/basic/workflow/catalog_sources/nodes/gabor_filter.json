{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.gabor-filter",
  "display_name": "Gabor Filter",
  "category": "opencv.image.filter",
  "description": "使用 Gabor 核增强指定方向和空间频率的纹理响应。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {
      "name": "image",
      "display_name": "Image",
      "payload_type_id": "image-ref.v1"
    }
  ],
  "output_ports": [
    {
      "name": "image",
      "display_name": "Image",
      "payload_type_id": "image-ref.v1"
    }
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "kernel_size": {
        "type": "integer",
        "default": 21,
        "minimum": 3
      },
      "sigma": {
        "type": "number",
        "default": 5.0,
        "minimum": 0.01
      },
      "theta_deg": {
        "type": "number",
        "default": 0.0
      },
      "wavelength": {
        "type": "number",
        "default": 10.0,
        "minimum": 0.01
      },
      "gamma": {
        "type": "number",
        "default": 0.5,
        "minimum": 0.01
      },
      "phase_deg": {
        "type": "number",
        "default": 0.0
      },
      "output_object_key": {
        "type": "string"
      }
    }
  },
  "capability_tags": [
    "opencv.gabor-filter",
    "vision.opencv"
  ],
  "runtime_requirements": {
    "python_packages": [
      "opencv-python",
      "numpy"
    ]
  },
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
