{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.brightness-contrast",
  "display_name": "Brightness Contrast",
  "category": "opencv.image.enhancement",
  "description": "按 dst = src × alpha + beta 调整亮度与对比度。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {
      "name": "image",
      "display_name": "Image",
      "payload_type_id": "image-ref.v1"
    }
  ],
  "output_ports": [
    {
      "name": "image",
      "display_name": "Image",
      "payload_type_id": "image-ref.v1"
    }
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "alpha": {
        "type": "number",
        "default": 1.0,
        "minimum": 0.0
      },
      "beta": {
        "type": "number",
        "default": 0.0,
        "minimum": -255,
        "maximum": 255
      },
      "save_location": {
        "type": "string"
      }
    }
  },
  "capability_tags": [
    "opencv.brightness-contrast",
    "vision.opencv"
  ],
  "runtime_requirements": {
    "python_packages": [
      "opencv-python",
      "numpy"
    ]
  },
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
