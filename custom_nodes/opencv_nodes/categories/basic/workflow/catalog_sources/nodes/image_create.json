{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.image-create",
  "display_name": "Image Create",
  "category": "opencv.image.transform",
  "description": "按宽、高、通道、dtype 和填充值创建一张执行期图片。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [],
  "output_ports": [
    {"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"}
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "width": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 640},
      "height": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 480},
      "channels": {"type": "integer", "enum": [1, 3, 4], "default": 3},
      "dtype": {"type": "string", "enum": ["uint8", "uint16", "float32"], "default": "uint8"},
      "fill_value": {
        "oneOf": [
          {"type": "number"},
          {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 4}
        ],
        "default": 0
      }
    }
  },
  "capability_tags": ["opencv.image-create", "vision.opencv"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
