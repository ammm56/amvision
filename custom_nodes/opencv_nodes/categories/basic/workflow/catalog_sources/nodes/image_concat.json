{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.image-concat",
  "display_name": "Image Concat",
  "category": "opencv.image.transform",
  "description": "水平或垂直规则拼接图片集合，并明确对齐、间隔和填充值。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {"name": "images", "display_name": "Images", "payload_type_id": "image-refs.v1"}
  ],
  "output_ports": [
    {"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"}
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "axis": {"type": "string", "enum": ["horizontal", "vertical"], "default": "horizontal"},
      "alignment": {"type": "string", "enum": ["start", "center", "end"], "default": "center"},
      "gap": {"type": "integer", "minimum": 0, "maximum": 65535, "default": 0},
      "fill_value": {
        "oneOf": [
          {"type": "number"},
          {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 4}
        ],
        "default": 0
      }
    }
  },
  "capability_tags": ["opencv.image-concat", "vision.opencv"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
