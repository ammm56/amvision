{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.mask-logic",
  "display_name": "Mask Logic",
  "category": "opencv.mask.operation",
  "description": "对一个或两个 mask 执行 AND、OR、XOR 或 NOT 运算。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {
      "name": "mask_a",
      "display_name": "Mask A",
      "payload_type_id": "image-ref.v1"
    },
    {
      "name": "mask_b",
      "display_name": "Mask B",
      "payload_type_id": "image-ref.v1",
      "required": false
    }
  ],
  "output_ports": [
    {
      "name": "mask",
      "display_name": "Mask",
      "payload_type_id": "image-ref.v1"
    }
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "default": "and",
        "enum": [
          "and",
          "or",
          "xor",
          "not"
        ]
      },
      "save_location": {
        "type": "string"
      }
    }
  },
  "capability_tags": [
    "opencv.mask-logic",
    "vision.opencv"
  ],
  "runtime_requirements": {
    "python_packages": [
      "opencv-python",
      "numpy"
    ]
  },
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
