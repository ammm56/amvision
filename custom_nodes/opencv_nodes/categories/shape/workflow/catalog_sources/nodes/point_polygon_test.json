{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.point-polygon-test",
  "display_name": "Point Polygon Test",
  "category": "opencv.shape",
  "description": "判断一个或多个点位于指定轮廓内部、边界还是外部，并可输出有符号距离。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {
      "name": "contours",
      "display_name": "Contours",
      "payload_type_id": "contours.v1"
    }
  ],
  "output_ports": [
    {
      "name": "result",
      "display_name": "Result",
      "payload_type_id": "value.v1"
    }
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "contour_index": {
        "type": "integer",
        "default": 1,
        "minimum": 1
      },
      "point_xy": {
        "type": "array",
        "default": [
          0,
          0
        ],
        "items": {
          "type": "number"
        }
      },
      "points_xy": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "measure_distance": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "capability_tags": [
    "opencv.point-polygon-test",
    "vision.opencv"
  ],
  "runtime_requirements": {
    "python_packages": [
      "opencv-python",
      "numpy"
    ]
  },
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
