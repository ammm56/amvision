{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.shape-match",
  "display_name": "Shape Match",
  "category": "opencv.geometry.shape",
  "description": "使用 Hu 矩比较两个 contour 集合中的指定轮廓，分数越低越相似。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {
      "name": "contours_a",
      "display_name": "Contours A",
      "payload_type_id": "contours.v1"
    },
    {
      "name": "contours_b",
      "display_name": "Contours B",
      "payload_type_id": "contours.v1"
    }
  ],
  "output_ports": [
    {
      "name": "score",
      "display_name": "Score",
      "payload_type_id": "value.v1"
    },
    {
      "name": "summary",
      "display_name": "Summary",
      "payload_type_id": "value.v1"
    }
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "contour_index_a": {
        "type": "integer",
        "default": 1,
        "minimum": 1
      },
      "contour_index_b": {
        "type": "integer",
        "default": 1,
        "minimum": 1
      },
      "method": {
        "type": "string",
        "default": "i1",
        "enum": [
          "i1",
          "i2",
          "i3"
        ]
      }
    }
  },
  "capability_tags": [
    "opencv.shape-match",
    "vision.opencv"
  ],
  "runtime_requirements": {
    "python_packages": [
      "opencv-python",
      "numpy"
    ]
  },
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
