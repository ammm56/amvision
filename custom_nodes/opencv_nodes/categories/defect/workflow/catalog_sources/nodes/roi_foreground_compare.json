{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.roi-foreground-compare",
  "version": "0.1.8",
  "display_name": "ROI Foreground Compare",
  "category": "opencv.inspection.difference",
  "description": "在共同坐标系内比较各 ROI 前景的缺失和溢出；不自动对齐，不测量高度。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {
      "name": "image",
      "display_name": "Image",
      "payload_type_id": "image-ref.v1"
    },
    {
      "name": "reference_image",
      "display_name": "Reference Image",
      "payload_type_id": "image-ref.v1"
    },
    {
      "name": "rois",
      "display_name": "ROIs",
      "payload_type_id": "roi-list.v1"
    }
  ],
  "output_ports": [
    {
      "name": "summary",
      "display_name": "Comparison",
      "payload_type_id": "value.v1"
    },
    {
      "name": "regions",
      "display_name": "Regions",
      "payload_type_id": "regions.v1"
    },
    {
      "name": "comparison_images",
      "display_name": "Comparison Images",
      "payload_type_id": "image-refs.v1"
    }
  ],
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "threshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 255,
        "default": 80,
        "title": "灰度阈值"
      },
      "foreground": {
        "type": "string",
        "enum": [
          "dark",
          "light"
        ],
        "default": "dark",
        "title": "前景明暗"
      },
      "tolerance_pixels": {
        "type": "integer",
        "minimum": 0,
        "maximum": 64,
        "default": 2,
        "title": "边缘容差（输入图像素）"
      },
      "min_reference_area": {
        "type": "integer",
        "minimum": 1,
        "default": 100,
        "title": "最小参考前景面积"
      },
      "max_missing_ratio": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.05,
        "title": "最大缺失比例"
      },
      "max_excess_ratio": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.05,
        "title": "最大溢出比例"
      },
      "check_pose": {
        "type": "boolean",
        "default": false,
        "title": "检查质心和主轴"
      },
      "max_centroid_shift_pixels": {
        "type": "number",
        "minimum": 0,
        "default": 8,
        "title": "最大质心偏移（像素）"
      },
      "max_axis_angle_degrees": {
        "type": "number",
        "minimum": 0,
        "maximum": 90,
        "default": 3,
        "title": "最大主轴角差（度）"
      },
      "emit_comparison_images": {
        "type": "boolean",
        "default": false,
        "title": "输出逐 ROI 差异图"
      },
      "check_boundary": {
        "type": "boolean",
        "default": false,
        "title": "检查前景是否越过 ROI"
      },
      "search_margin_pixels": {
        "type": "integer",
        "minimum": 1,
        "maximum": 128,
        "default": 8,
        "title": "边界外搜索余量（像素）"
      },
      "max_outside_ratio": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.02,
        "title": "最大越界前景比例"
      }
    }
  },
  "capability_tags": [
    "vision.inspection",
    "opencv.foreground-comparison"
  ],
  "runtime_requirements": {
    "python_packages": [
      "opencv-python",
      "numpy"
    ]
  },
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.8"
}
