{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.grabcut",
  "display_name": "GrabCut",
  "category": "opencv.segmentation.image",
  "description": "使用矩形或可选初始 mask 执行交互式前景分割。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"},
    {"name": "mask", "display_name": "Initial Mask", "payload_type_id": "image-ref.v1", "required": false}
  ],
  "output_ports": [
    {"name": "image", "display_name": "Foreground Image", "payload_type_id": "image-ref.v1"},
    {"name": "mask", "display_name": "Mask", "payload_type_id": "image-ref.v1"},
    {"name": "summary", "display_name": "Summary", "payload_type_id": "value.v1"}
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "x": {"type": "integer", "minimum": 0},
      "y": {"type": "integer", "minimum": 0},
      "width": {"type": "integer", "minimum": 1},
      "height": {"type": "integer", "minimum": 1},
      "iterations": {"type": "integer", "default": 5, "minimum": 1},
      "save_location": {"type": "string"}
    }
  },
  "capability_tags": ["opencv.grabcut", "vision.opencv", "vision.segmentation"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
