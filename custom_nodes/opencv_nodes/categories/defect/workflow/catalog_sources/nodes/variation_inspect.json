{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.variation-inspect",
  "display_name": "Variation Inspect",
  "category": "opencv.inspection.difference",
  "description": "使用正常样本变化模型输出异常热图、区域和统计。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"},
    {"name": "model", "display_name": "Variation Model", "payload_type_id": "value.v1"}
  ],
  "output_ports": [
    {"name": "heatmap", "display_name": "Anomaly Heatmap", "payload_type_id": "image-ref.v1"},
    {"name": "error_regions", "display_name": "Error Regions", "payload_type_id": "regions.v1"},
    {"name": "statistics", "display_name": "Statistics", "payload_type_id": "value.v1"}
  ],
  "parameter_schema": {"type": "object", "properties": {
    "z_score_threshold": {"type": "number", "exclusiveMinimum": 0, "default": 4},
    "minimum_area": {"type": "integer", "minimum": 1, "default": 4},
    "morphology_size": {"type": "integer", "minimum": 0, "maximum": 31, "default": 3},
    "heatmap_max_z_score": {"type": "number", "exclusiveMinimum": 0, "default": 8},
    "save_location": {"type": "string"}
  }},
  "capability_tags": ["opencv.variation-inspect", "vision.inspection", "inspection.difference"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
