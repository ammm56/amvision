{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.mask-items-properties",
  "version": "0.1.8",
  "display_name": "Mask Items Properties",
  "category": "opencv.inspection.measurement",
  "description": "测量前景像素面积、公共图像坐标质心及无向主轴，不作合格判定。",
  "implementation_kind": "custom-node",
