    {
      "name": "masks",
      "display_name": "Masks",
      "payload_type_id": "image-refs.v1",
      "required": true
    }
  ],
  "output_ports": [
    {
      "name": "metrics",
      "display_name": "Metrics",
      "payload_type_id": "value.v1",
      "required": true
    }
  ],
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "min_axis_anisotropy": {
        "type": "number",
        "title": "最小主轴各向异性",
        "default": 0.1,
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  "capability_tags": [
    "vision.inspection",
    "opencv.measurement-items"
  ],
  "runtime_requirements": {
    "python_packages": [
      "opencv-python",
      "numpy"
    ]
  },
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.8"
}
