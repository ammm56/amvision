{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.morphology-hitmiss",
  "display_name": "Morphology HitMiss",
  "category": "opencv.defect",
  "description": "使用包含 -1、0、1 的结构元素在二值图中搜索像素模式。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [{"name": "image", "display_name": "Mask", "payload_type_id": "image-ref.v1"}],
  "output_ports": [
    {"name": "mask", "display_name": "Matches", "payload_type_id": "image-ref.v1"},
    {"name": "summary", "display_name": "Summary", "payload_type_id": "value.v1"}
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "kernel": {
        "type": "array",
        "default": [[-1, -1, -1], [0, 1, 0], [1, 1, 1]],
        "items": {"type": "array", "items": {"type": "integer", "enum": [-1, 0, 1]}}
      },
      "output_object_key": {"type": "string"}
    }
  },
  "capability_tags": ["opencv.morphology-hitmiss", "vision.opencv", "vision.region"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
