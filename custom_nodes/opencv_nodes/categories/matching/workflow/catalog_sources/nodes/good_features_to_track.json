{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.good-features-to-track",
  "display_name": "Good Features To Track",
  "category": "opencv.feature.detection",
  "description": "使用 Shi-Tomasi 或 Harris 响应提取适合跟踪的强角点。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [{"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"}],
  "output_ports": [{"name": "points", "display_name": "Points", "payload_type_id": "value.v1"}],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "max_corners": {"type": "integer", "default": 200, "minimum": 1},
      "quality_level": {"type": "number", "default": 0.01, "exclusiveMinimum": 0, "maximum": 1},
      "min_distance": {"type": "number", "default": 5.0, "minimum": 0},
      "block_size": {"type": "integer", "default": 3, "minimum": 2},
      "use_harris": {"type": "boolean", "default": false}
    }
  },
  "capability_tags": ["opencv.good-features-to-track", "vision.opencv", "vision.features"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
