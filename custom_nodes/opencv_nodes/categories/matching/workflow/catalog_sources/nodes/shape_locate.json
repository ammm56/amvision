{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.shape-locate",
  "display_name": "Shape Locate",
  "category": "opencv.matching.template",
  "description": "在离散角度和尺度范围内搜索边缘形状模板，输出统一 localization 和相似变换。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"},
    {"name": "template_image", "display_name": "Template Image", "payload_type_id": "image-ref.v1"}
  ],
  "output_ports": [
    {"name": "localizations", "display_name": "Localizations", "payload_type_id": "localizations.v1"},
    {"name": "transform", "display_name": "Transform", "payload_type_id": "planar-transform.v1"}
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "canny_low_threshold": {"type": "number", "minimum": 0.0, "maximum": 255.0, "default": 50.0},
      "canny_high_threshold": {"type": "number", "minimum": 0.0, "maximum": 255.0, "default": 150.0},
      "angle_min": {"type": "number", "default": 0.0},
      "angle_max": {"type": "number", "default": 0.0},
      "angle_step": {"type": "number", "exclusiveMinimum": 0.0, "default": 1.0},
      "scale_min": {"type": "number", "exclusiveMinimum": 0.0, "default": 1.0},
      "scale_max": {"type": "number", "exclusiveMinimum": 0.0, "default": 1.0},
      "scale_step": {"type": "number", "exclusiveMinimum": 0.0, "default": 0.1},
      "minimum_score": {"type": "number", "minimum": -1.0, "maximum": 1.0, "default": 0.5}
    }
  },
  "capability_tags": ["opencv.shape-locate", "vision.opencv", "vision.localization"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
