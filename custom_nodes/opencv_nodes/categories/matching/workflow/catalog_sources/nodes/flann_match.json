{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.flann-match",
  "display_name": "FLANN Match",
  "category": "opencv.matching.feature",
  "description": "使用 KD-Tree 或 LSH 对 float32 或 binary 局部描述子执行近邻匹配。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {"name": "features_a", "display_name": "Features A", "payload_type_id": "local-features.v1"},
    {"name": "features_b", "display_name": "Features B", "payload_type_id": "local-features.v1"}
  ],
  "output_ports": [
    {"name": "matches", "display_name": "Matches", "payload_type_id": "feature-matches.v1"},
    {"name": "summary", "display_name": "Summary", "payload_type_id": "value.v1"}
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "ratio_test_threshold": {"type": "number", "default": 0.75, "exclusiveMinimum": 0, "exclusiveMaximum": 1},
      "max_matches": {"type": "integer", "default": 200, "minimum": 1}
    }
  },
  "capability_tags": ["opencv.flann-match", "vision.opencv", "vision.matching"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
