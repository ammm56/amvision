{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.circle-pattern-locate",
  "version": "0.1.8",
  "display_name": "Circle Pattern Locate",
  "category": "opencv.matching.registration",
  "description": "匹配带名称的参考圆心与候选圆，验证整个图案后输出刚性变换；不使用圆的列表顺序。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "concurrency_policy": "thread-safe",
  "input_ports": [
    {
      "name": "circles",
      "display_name": "Circles",
      "payload_type_id": "circles.v1",
      "required": true
    }
  ],
  "output_ports": [
    {
      "name": "transform",
      "display_name": "Transform",
      "payload_type_id": "planar-transform.v1",
      "required": true
    },
    {
      "name": "summary",
      "display_name": "Summary",
      "payload_type_id": "value.v1",
      "required": true
    }
  ],
  "parameter_schema": {
    "additionalProperties": false,
    "description": "以候选圆输入图像的像素为单位设置搜索边界与配准门槛。",
    "properties": {
      "reference_points": {
        "items": {
          "additionalProperties": false,
          "description": "参考点名称和坐标；名称负责关联，数组顺序不参与匹配。",
          "properties": {
            "point_id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "center_xy": {
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "point_id",
            "center_xy"
          ],
          "type": "object"
        },
        "maxItems": 64,
        "minItems": 3,
        "type": "array"
      },
      "match_tolerance_px": {
        "default": 8,
        "exclusiveMinimum": 0,
        "maximum": 100,
        "type": "number"
      },
      "maximum_rmse_px": {
        "default": 2,
        "exclusiveMinimum": 0,
        "maximum": 100,
        "type": "number"
      },
      "minimum_match_ratio": {
        "default": 0.9,
        "exclusiveMinimum": 0,
        "maximum": 1,
        "type": "number"
      },
      "maximum_angle_degrees": {
        "default": 10,
        "maximum": 180,
        "minimum": 0,
        "type": "number"
      },
      "maximum_translation_px": {
        "default": 500,
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maximum_hypotheses": {
        "default": 5000,
        "maximum": 50000,
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "reference_points"
    ],
    "type": "object"
  },
  "capability_tags": [
    "opencv.circle-pattern-locate",
    "vision.opencv"
  ],
  "runtime_requirements": {
    "python_packages": [
      "opencv-python",
      "numpy"
    ]
  },
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.8"
}
