{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.radial-line-search",
  "display_name": "Radial Line Search",
  "category": "opencv.measurement.circle",
  "description": "从中心沿多条径向搜索边缘，输出点集、覆盖率和可选圆或椭圆拟合。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [{"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"}],
  "output_ports": [
    {"name": "points", "display_name": "Edge Points", "payload_type_id": "points.v1"},
    {"name": "circles", "display_name": "Circles", "payload_type_id": "circles.v1", "required": false},
    {"name": "ellipses", "display_name": "Ellipses", "payload_type_id": "ellipses.v1", "required": false},
    {"name": "measurements", "display_name": "Measurements", "payload_type_id": "measurements.v1"}
  ],
  "parameter_schema": {
    "type": "object",
    "required": ["center_xy", "outer_radius"],
    "properties": {
      "center_xy": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
      "inner_radius": {"type": "number", "minimum": 0.0, "default": 0.0},
      "outer_radius": {"type": "number", "minimum": 0.0},
      "ray_count": {"type": "integer", "minimum": 5, "maximum": 4096, "default": 72},
      "gradient_threshold": {"type": "number", "minimum": 0.0, "default": 5.0},
      "edge_polarity": {"type": "string", "enum": ["any", "dark-to-bright", "bright-to-dark"], "default": "any"},
      "fit_kind": {"type": "string", "enum": ["none", "circle", "ellipse"], "default": "circle"}
    }
  },
  "capability_tags": ["opencv.radial-search", "vision.opencv", "measurement.circle"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
