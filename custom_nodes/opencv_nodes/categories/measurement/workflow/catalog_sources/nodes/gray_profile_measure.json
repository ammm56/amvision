{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.gray-profile-measure",
  "display_name": "Gray Profile Measure",
  "category": "opencv.measurement.edge",
  "description": "沿线或带状区域输出亚像素采样灰度剖面、梯度和峰谷位置。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [{"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"}],
  "output_ports": [{"name": "profile", "display_name": "Profile", "payload_type_id": "value.v1"}],
  "parameter_schema": {
    "type": "object",
    "required": ["start_xy", "end_xy"],
    "properties": {
      "start_xy": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
      "end_xy": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
      "sample_count": {"type": "integer", "minimum": 2, "maximum": 65536},
      "band_width": {"type": "number", "minimum": 1.0, "maximum": 4096.0, "default": 1.0},
      "smooth_sigma": {"type": "number", "minimum": 0.0, "default": 0.0},
      "peak_count": {"type": "integer", "minimum": 1, "maximum": 128, "default": 5}
    }
  },
  "capability_tags": ["opencv.gray-profile", "vision.opencv", "measurement.edge"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
