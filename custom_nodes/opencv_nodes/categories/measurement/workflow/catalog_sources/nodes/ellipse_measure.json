{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.ellipse-measure",
  "display_name": "Ellipse Measure",
  "category": "opencv.measurement.geometry",
  "description": "沿名义椭圆法向采样边缘并拟合椭圆，输出覆盖率和残差。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"},
    {"name": "ellipse", "display_name": "Nominal Ellipse", "payload_type_id": "ellipses.v1"}
  ],
  "output_ports": [
    {"name": "points", "display_name": "Edge Points", "payload_type_id": "points.v1"},
    {"name": "ellipses", "display_name": "Ellipses", "payload_type_id": "ellipses.v1"},
    {"name": "measurements", "display_name": "Measurements", "payload_type_id": "measurements.v1"}
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "sample_count": {"type": "integer", "minimum": 5, "maximum": 4096, "default": 72},
      "search_length": {"type": "number", "minimum": 2.0, "default": 20.0},
      "gradient_threshold": {"type": "number", "minimum": 0.0, "default": 5.0},
      "edge_polarity": {"type": "string", "enum": ["any", "dark-to-bright", "bright-to-dark"], "default": "any"}
    }
  },
  "capability_tags": ["opencv.ellipse-measure", "vision.opencv", "measurement.geometry"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
