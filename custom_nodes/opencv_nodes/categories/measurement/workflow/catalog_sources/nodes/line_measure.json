{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.line-measure",
  "display_name": "Line Measure",
  "category": "opencv.measurement.edge",
  "description": "沿名义线布置法向卡尺，检测边缘点并拟合直线、残差和有效率。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [{"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"}],
  "output_ports": [
    {"name": "points", "display_name": "Edge Points", "payload_type_id": "points.v1"},
    {"name": "lines", "display_name": "Lines", "payload_type_id": "lines.v1"},
    {"name": "measurements", "display_name": "Measurements", "payload_type_id": "measurements.v1"}
  ],
  "parameter_schema": {
    "type": "object",
    "required": ["start_xy", "end_xy"],
    "properties": {
      "start_xy": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
      "end_xy": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
      "caliper_length": {"type": "number", "minimum": 2.0, "default": 20.0},
      "caliper_count": {"type": "integer", "minimum": 2, "maximum": 4096, "default": 20},
      "gradient_threshold": {"type": "number", "minimum": 0.0, "default": 5.0},
      "edge_polarity": {"type": "string", "enum": ["any", "dark-to-bright", "bright-to-dark"], "default": "any"}
    }
  },
  "capability_tags": ["opencv.line-measure", "vision.opencv", "measurement.edge"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
