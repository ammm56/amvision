{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.circle-grid-detect",
  "display_name": "Circle Grid Detect",
  "category": "opencv.calibration",
  "description": "检测对称或非对称圆点阵并输出带物理坐标的标定观测。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [{"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"}],
  "output_ports": [{"name": "observation", "display_name": "Observation", "payload_type_id": "value.v1"}],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "columns": {"type": "integer", "default": 4, "minimum": 2},
      "rows": {"type": "integer", "default": 11, "minimum": 2},
      "spacing": {"type": "number", "default": 1.0, "minimum": 1e-09},
      "asymmetric": {"type": "boolean", "default": true},
      "use_clustering": {"type": "boolean", "default": true}
    }
  },
  "capability_tags": ["opencv.circle-grid-detect", "vision.opencv", "vision.calibration"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
