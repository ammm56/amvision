{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.corner-subpix",
  "display_name": "Corner SubPix",
  "category": "opencv.calibration",
  "description": "依据灰度梯度对二维角点执行亚像素细化。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"},
    {"name": "points", "display_name": "Points", "payload_type_id": "value.v1"}
  ],
  "output_ports": [{"name": "points", "display_name": "Refined Points", "payload_type_id": "value.v1"}],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "window_size": {"type": "integer", "default": 5, "minimum": 1},
      "zero_zone": {"type": "integer", "default": -1, "minimum": -1},
      "max_iterations": {"type": "integer", "default": 30, "minimum": 1},
      "epsilon": {"type": "number", "default": 0.01, "minimum": 1e-09}
    }
  },
  "capability_tags": ["opencv.corner-subpix", "vision.opencv", "vision.calibration"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
