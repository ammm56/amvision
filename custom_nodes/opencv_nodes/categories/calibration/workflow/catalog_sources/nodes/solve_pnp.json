{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.solve-pnp",
  "display_name": "Solve PnP",
  "category": "opencv.calibration",
  "description": "根据标定观测和相机内参估计物体位姿，并返回重投影误差。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [
    {
      "name": "observation",
      "display_name": "Observation",
      "payload_type_id": "value.v1"
    },
    {
      "name": "calibration",
      "display_name": "Calibration",
      "payload_type_id": "value.v1"
    }
  ],
  "output_ports": [
    {
      "name": "pose",
      "display_name": "Pose",
      "payload_type_id": "value.v1"
    }
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "method": {
        "type": "string",
        "default": "iterative",
        "enum": [
          "iterative",
          "epnp",
          "p3p",
          "ippe",
          "ippe-square"
        ]
      }
    }
  },
  "capability_tags": [
    "opencv.solve-pnp",
    "vision.opencv"
  ],
  "runtime_requirements": {
    "python_packages": [
      "opencv-python",
      "numpy"
    ]
  },
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
