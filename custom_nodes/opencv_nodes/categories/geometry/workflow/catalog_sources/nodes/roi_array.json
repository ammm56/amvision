{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.roi-array",
  "version": "0.1.8",
  "display_name": "ROI Array",
  "category": "opencv.image.transform",
  "description": "复制首槽矩形或多边形；行列二维向量阵列。Frame 可选：首槽使用矩形裁图局部坐标，输出父图坐标。越界拒绝。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "concurrency_policy": "thread-safe",
  "input_ports": [
    {
      "name": "roi",
      "display_name": "Roi",
      "payload_type_id": "roi.v1",
      "required": true
    },
    {
      "name": "frame",
      "display_name": "Frame",
      "payload_type_id": "roi.v1",
      "required": false
    },
    {
      "name": "image",
      "display_name": "Image",
      "payload_type_id": "image-ref.v1",
      "required": false
    }
  ],
  "output_ports": [
    {
      "name": "rois",
      "display_name": "Rois",
      "payload_type_id": "roi-list.v1",
      "required": true
    },
    {
      "name": "summary",
      "display_name": "Summary",
      "payload_type_id": "value.v1",
      "required": true
    },
    {
      "name": "debug_preview",
      "display_name": "Debug Preview",
      "payload_type_id": "response-body.v1",
      "required": false
    }
  ],
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rows": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 1,
        "title": "行数"
      },
      "columns": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 1,
        "title": "列数"
      },
      "column_step_xy": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2,
        "default": [
          100,
          0
        ],
        "title": "列位移 [X, Y]"
      },
      "row_step_xy": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2,
        "default": [
          0,
          100
        ],
        "title": "行位移 [X, Y]"
      },
      "roi_id_prefix": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "default": "roi",
        "title": "ROI 名称前缀"
      },
      "debug_image_panel_enabled": {
        "type": "boolean",
        "title": "显示调试图",
        "description": "仅编辑 Preview Run 使用；生产 runtime 默认不会生成调试图片。",
        "default": false
      },
      "debug_image_panel_transport_mode": {
        "type": "string",
        "title": "调试图返回方式",
        "description": "storage-ref 会保存为 Preview Run artifact；inline-base64 只适合小图快速调试。",
        "enum": [
          "storage-ref",
          "inline-base64"
        ],
        "default": "storage-ref"
      }
    }
  },
  "capability_tags": [
    "vision.geometry",
    "opencv.roi-array"
  ],
  "runtime_requirements": {
    "python_packages": [
      "opencv-python",
      "numpy"
    ]
  },
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.8"
}
