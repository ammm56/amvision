{
  "format_id": "amvision.node-definition.v1",
  "node_type_id": "custom.opencv.pad-border",
  "display_name": "Pad Border",
  "category": "opencv.image.transform",
  "description": "按 constant、replicate、reflect 或 wrap 策略扩展图像边界。",
  "implementation_kind": "custom-node",
  "runtime_kind": "python-callable",
  "input_ports": [{"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"}],
  "output_ports": [{"name": "image", "display_name": "Image", "payload_type_id": "image-ref.v1"}],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "top": {"type": "integer", "default": 0, "minimum": 0},
      "bottom": {"type": "integer", "default": 0, "minimum": 0},
      "left": {"type": "integer", "default": 0, "minimum": 0},
      "right": {"type": "integer", "default": 0, "minimum": 0},
      "border_mode": {"type": "string", "enum": ["constant", "replicate", "reflect", "reflect101", "wrap"], "default": "constant"},
      "border_value": {"type": "array", "default": [0, 0, 0], "items": {"type": "number"}, "minItems": 1, "maxItems": 4},
      "save_location": {"type": "string"}
    }
  },
  "capability_tags": ["opencv.pad-border", "vision.opencv", "vision.geometry"],
  "runtime_requirements": {"python_packages": ["opencv-python", "numpy"]},
  "node_pack_id": "opencv.nodes",
  "node_pack_version": "0.1.3"
}
