{
  "format_id": "amvision.node-pack-manifest.v1",
  "id": "opencv.nodes",
  "version": "0.1.8",
  "displayName": "OpenCV Nodes",
  "description": "提供通用 OpenCV 图像、圆心定位、几何阵列、ROI 取参、前景与边界比较、局部映射裁剪和可视化节点。",
  "category": "vision",
  "categoryRoot": "opencv",
  "implementationLayout": "categories",
  "capabilities": [
    "pipeline.node",
    "opencv.foreground-comparison",
    "opencv.roi-crop-inputs",
    "opencv.polygon-foreground-comparison",
    "vision.opencv",
    "vision.filter",
    "vision.segmentation",
    "vision.feature",
    "vision.geometry",
    "vision.matching",
    "vision.calibration",
    "vision.measurement",
    "vision.defect",
    "vision.render",
    "opencv.circle-pattern-locate",
    "opencv.mapped-roi-crop",
    "opencv.image-decode",
    "opencv.roi-array",
    "opencv.foreground-boundary-check",
    "opencv.mapped-roi-window"
  ],
  "entrypoints": {
    "backend": "custom_nodes.opencv_nodes.backend.entry:register"
  },
  "compatibility": {
    "api": ">=0.1 <1.0",
    "runtime": ">=3.12"
  },
  "timeout": {
    "defaultSeconds": 30,
    "maxSeconds": 30,
    "killGraceSeconds": 2
  },
  "enabledByDefault": true,
  "customNodeCatalogPath": "workflow/catalog.json",
  "metadata": {
    "categoryRoot": "opencv",
    "categoryModel": "two-level",
    "categoryDepth": 2,
    "layout": "categories/<implementation-module>"
  }
}
