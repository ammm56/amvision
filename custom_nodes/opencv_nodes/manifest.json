{
  "format_id": "amvision.node-pack-manifest.v1",
  "id": "opencv.nodes",
  "version": "0.1.3",
  "displayName": "OpenCV Nodes",
  "description": "提供统一的 OpenCV 图像处理、颜色与掩膜、几何、形状、匹配、标定、量测、缺陷分析和渲染节点。",
  "category": "vision",
  "categoryRoot": "opencv",
  "implementationLayout": "categories",
  "capabilities": [
    "pipeline.node",
    "vision.opencv",
    "vision.filter",
    "vision.geometry",
    "vision.matching",
    "vision.calibration",
    "vision.measurement",
    "vision.defect",
    "vision.render"
  ],
  "permissionScopes": [
    "objectstore.read.ref",
    "objectstore.write.ref"
  ],
  "entrypoints": {
    "backend": "custom_nodes.opencv_nodes.backend.entry:register"
  },
  "compatibility": {
    "api": ">=0.1 <1.0",
    "runtime": ">=3.12"
  },
  "timeout": {
    "defaultSeconds": 30
  },
  "enabledByDefault": true,
  "customNodeCatalogPath": "workflow/catalog.json",
  "metadata": {
    "categoryRoot": "opencv",
    "layout": "categories/<category>"
  }
}
