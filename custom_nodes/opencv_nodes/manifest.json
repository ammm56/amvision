{
  "format_id": "amvision.node-pack-manifest.v1",
  "id": "opencv.nodes",
  "version": "0.1.3",
  "displayName": "OpenCV Nodes",
  "description": "提供统一的 OpenCV 颜色、增强、滤波、阈值、分割、特征、模板、几何、标定、量测、检测和可视化节点。",
  "category": "vision",
  "categoryRoot": "opencv",
  "implementationLayout": "categories",
  "capabilities": [
    "pipeline.node",
    "vision.opencv",
    "vision.filter",
    "vision.segmentation",
    "vision.feature",
    "vision.geometry",
    "vision.matching",
    "vision.calibration",
    "vision.measurement",
    "vision.defect",
    "vision.render"
  ],
  "permissionScopes": [
    "objectstore.read.ref",
    "objectstore.write.ref"
  ],
  "entrypoints": {
    "backend": "custom_nodes.opencv_nodes.backend.entry:register"
  },
  "compatibility": {
    "api": ">=0.1 <1.0",
    "runtime": ">=3.12"
  },
  "timeout": {
    "defaultSeconds": 30,
    "maxSeconds": 30,
    "killGraceSeconds": 2
  },
  "execution": {
    "isolation": "workflow-process",
    "timeoutAction": "terminate-workflow-process"
  },
  "enabledByDefault": true,
  "customNodeCatalogPath": "workflow/catalog.json",
  "metadata": {
    "categoryRoot": "opencv",
    "categoryModel": "two-level",
    "categoryDepth": 2,
    "layout": "categories/<implementation-module>"
  }
}
