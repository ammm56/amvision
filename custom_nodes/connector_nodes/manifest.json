{
  "format_id": "amvision.node-pack-manifest.v1",
  "id": "connector.nodes",
  "version": "0.1.8",
  "displayName": "Connector Nodes",
  "description": "二维连接器 PIN 观测与命名尺寸测量；产品布局和公差通过 Workflow 配置。",
  "category": "vision",
  "categoryRoot": "connector",
  "implementationLayout": "categories",
  "capabilities": [
    "pipeline.node",
    "vision.connector",
    "vision.measurement"
  ],
  "entrypoints": {
    "backend": "custom_nodes.connector_nodes.backend.entry:register"
  },
  "compatibility": {
    "api": ">=0.1.8 <0.2",
    "runtime": ">=3.12"
  },
  "dependencies": [
    {
      "nodePackId": "opencv.nodes",
      "versionRange": ">=0.1.8 <0.2"
    }
  ],
  "timeout": {
    "defaultSeconds": 30,
    "maxSeconds": 30,
    "killGraceSeconds": 2
  },
  "enabledByDefault": true,
  "customNodeCatalogPath": "workflow/catalog.json",
  "metadata": {
    "categoryRoot": "connector",
    "categoryModel": "two-level",
    "categoryDepth": 2,
    "layout": "categories/<implementation-module>",
    "developmentOnly": true
  }
}
