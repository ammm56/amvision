          "metadata": {}
        }
      ],
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8192,
            "items": {
              "additionalProperties": false,
              "description": "命名尺寸项；公差由通用 Check Limits 配置。",
              "properties": {
                "item_id": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "title": "Item Id",
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "width",
                    "pitch",
                    "total_pitch",
                    "gap",
                    "offset",
                    "length",
                    "angle"
                  ],
                  "title": "Kind",
                  "type": "string"
                },
                "enabled": {
                  "default": true,
                  "title": "Enabled",
                  "type": "boolean"
                },
                "pin_a": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "title": "Pin A",
                  "type": "string"
                },
                "pin_b": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
