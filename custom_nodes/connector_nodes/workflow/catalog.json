                },
                "direction": {
                  "default": [
                    1.0,
                    0.0
                  ],
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "title": "Direction",
                  "type": "array"
                },
                "section": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Section"
                },
                "distance_mode": {
                  "default": "projected",
                  "enum": [
                    "projected",
                    "euclidean"
                  ],
                  "title": "Distance Mode",
                  "type": "string"
                },
                "feature_a": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Feature A"
                },
                "feature_b": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "title": "Feature B"
                }
              },
              "required": [
                "item_id",
                "kind",
                "pin_a"
              ],
              "title": "MeasurementDefinition",
              "type": "object"
            },
            "x-ui-widget": "object-rows"
          },
          "unit": {
            "type": "string",
            "enum": [
              "pixel",
              "millimeter",
              "meter"
            ],
            "default": "pixel"
          },
          "calibration_resource": {
            "additionalProperties": false,
            "description": "项目内不可变资源版本与内容摘要；不能用本地路径代替引用。",
            "properties": {
              "project_id": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                "title": "Project Id",
