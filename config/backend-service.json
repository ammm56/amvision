{
  "app": {
    "app_name": "amvision backend-service",
    "app_version": "0.1.4"
  },
  "cors": {
    "enabled": true,
    "allow_origins": [],
    "allow_origin_regex": "^https?://(localhost|127\\.0\\.0\\.1)(:\\d+)?$",
    "allow_credentials": true,
    "allow_methods": ["*"],
    "allow_headers": ["*"],
    "expose_headers": [
      "x-request-id",
      "x-offset",
      "x-limit",
      "x-total-count",
      "x-has-more",
      "x-next-offset"
    ]
  },
  "auth": {
    "mode": "local",
    "websocket_query_token_enabled": true,
    "local_auth": {
      "password_min_length": 6,
      "initialize_default_user_on_empty_db": true
    },
    "static_tokens": []
  },
  "projects": {
    "items": []
  },
  "database": {
    "url": "sqlite:///./data/amvision.db",
    "echo": false
  },
  "dataset_storage": {
    "root_dir": "./data/files",
    "max_import_package_bytes": 21474836480,
    "max_import_extracted_bytes": 214748364800,
    "max_import_member_count": 2000000,
    "max_import_compression_ratio": 1000.0,
    "max_import_metadata_file_bytes": 268435456,
    "max_import_label_file_bytes": 16777216,
    "max_import_sample_count": 100000,
    "max_import_annotation_count": 1000000
  },
  "queue": {
    "root_dir": "./data/queue",
    "lease_timeout_seconds": 86400.0,
    "completed_retention_seconds": 86400.0,
    "failed_retention_seconds": 604800.0,
    "response_queue_retention_seconds": 3600.0,
    "file_operation_retry_timeout_seconds": 2.0
  },
  "queue_outbox": {
    "enabled": true,
    "batch_size": 32,
    "poll_interval_seconds": 0.2,
    "lease_seconds": 30.0,
    "retry_base_seconds": 0.5,
    "retry_max_seconds": 30.0,
    "shutdown_timeout_seconds": 5.0
  },
  "training_telemetry": {
    "enabled": true,
    "root_dir": "./data/runtime/training-telemetry",
    "slot_count": 512,
    "payload_capacity_bytes": 16384,
    "poll_interval_seconds": 0.1,
    "scan_interval_seconds": 1.0
  },
  "async_inference_gateway": {
    "service_id": "backend-service-main"
  },
  "workflow_runtime": {
    "operator_thread_count": 4,
    "decoded_image_cache_max_entries": 8,
    "decoded_image_cache_max_bytes": 268435456,
      "raw_result_cache_ttl_seconds": 900.0,
      "raw_result_cache_max_items": 64,
      "model_startup_timeout_seconds": 600.0,
      "preview_model_session_scope_limit": 1
    },
  "zeromq_trigger": {
    "buffer_ttl_seconds": 330.0,
    "buffer_ttl_safety_margin_seconds": 30.0,
    "receive_hwm": 1,
    "send_hwm": 1,
    "max_message_size_bytes": 134217728,
    "poll_timeout_ms": 100,
    "startup_timeout_seconds": 2.0,
    "shutdown_timeout_seconds": 10.0
  },
  "local_buffer_broker": {
    "enabled": true,
    "root_dir": "./data/buffers",
    "startup_timeout_seconds": 60.0,
    "takeover_existing_process": true,
    "takeover_timeout_seconds": 10.0,
    "request_timeout_seconds": 5.0,
    "shutdown_timeout_seconds": 5.0,
    "expire_interval_seconds": 5.0,
    "default_pool_name": "image-4k",
    "pools": [
      {
        "pool_name": "image-4k",
        "slot_size_bytes": 134217728,
        "slot_count": 16,
        "flush_on_write": false
      },
      {
        "pool_name": "image-1080p",
        "slot_size_bytes": 16777216,
        "slot_count": 16,
        "flush_on_write": false
      },
      {
        "pool_name": "image-640x640",
        "slot_size_bytes": 4194304,
        "slot_count": 16,
        "flush_on_write": false
      }
    ]
  },
  "deployment_process_supervisor": {
    "auto_restart": true,
    "monitor_interval_seconds": 0.5,
    "startup_timeout_seconds": 180.0,
    "request_timeout_seconds": 30.0,
    "shutdown_timeout_seconds": 5.0,
    "max_running_process_count": 32,
    "operator_thread_count": 1,
    "warmup_dummy_inference_count": 6,
    "warmup_dummy_image_size": [64, 64],
    "keep_warm_enabled": false,
    "keep_warm_interval_seconds": 0.1,
    "keep_warm_yield_timeout_seconds": 1.0,
    "tensorrt_pinned_output_buffer_enabled": true,
    "tensorrt_pinned_output_buffer_max_bytes": 8388608,
    "device_leases": {
      "root_dir": "./data/runtime/device-leases",
      "exclusive_acquire_timeout_seconds": 0.0,
      "shared_acquire_timeout_seconds": 0.0,
      "poll_interval_seconds": 0.05,
      "cuda_device_uuid_overrides": {},
      "conversion_cuda_device": "cuda:0"
    }
  },
  "deployment_runtime_reconciler": {
    "enabled": true,
    "reconcile_interval_seconds": 2.0,
    "controller_lease_seconds": 15.0,
    "restart_backoff_initial_seconds": 1.0,
    "restart_backoff_max_seconds": 60.0,
    "restart_backoff_jitter_ratio": 0.2
  },
  "inference_daemon": {
    "runtime_owner": "daemon",
    "service_id": "inference-daemon-main",
    "control_max_concurrent_requests": 8,
    "control_poll_interval_seconds": 0.05,
    "control_lease_timeout_seconds": 900.0,
    "control_read_timeout_seconds": 2.0,
    "availability_probe_timeout_seconds": 1.0,
    "mmap_mailbox": {
      "enabled": true,
      "slot_count": 128,
      "message_capacity_bytes": 524288,
      "overflow_page_count": 256,
      "overflow_page_capacity_bytes": 524288,
      "max_overflow_pages_per_response": 64,
      "compression_threshold_bytes": 262144,
      "max_concurrent_requests": 16,
      "poll_interval_seconds": 0.001
    }
  }
}
