        "description": "保存 opencv_process_save_image 的 FlowApplication。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"application\": {\n    \"format_id\": \"amvision.flow-application.v1\",\n    \"application_id\": \"opencv-process-save-image-app\",\n    \"display_name\": \"OpenCV Process Save Image App\",\n    \"description\": \"接收 base64 图片，执行 OpenCV 处理并把结果保存到本地磁盘。\",\n    \"template_ref\": {\n      \"template_id\": \"opencv-process-save-image-template\",\n      \"template_version\": \"1.0.0\",\n      \"source_kind\": \"json-file\",\n      \"source_uri\": \"docs/examples/workflows/opencv_process_save_image.template.json\"\n    },\n    \"bindings\": [\n      {\n        \"binding_id\": \"request_image_base64\",\n        \"direction\": \"input\",\n        \"template_port_id\": \"request_image_base64\",\n        \"binding_kind\": \"api-request\",\n        \"config\": {\n          \"route\": \"/api/v1/workflow-apps/opencv/process-save-image\",\n          \"method\": \"POST\"\n        },\n        \"metadata\": {\n          \"payload_type_id\": \"image-base64.v1\"\n        }\n      },\n      {\n        \"binding_id\": \"http_response\",\n        \"direction\": \"output\",\n        \"template_port_id\": \"http_response\",\n        \"binding_kind\": \"http-response\",\n        \"config\": {\n          \"status_code\": 200\n        },\n        \"metadata\": {\n          \"payload_type_id\": \"http-response.v1\"\n        }\n      }\n    ],\n    \"runtime_mode\": \"python-json-workflow\",\n    \"metadata\": {\n      \"example_kind\": \"opencv-process-save-image\",\n      \"intended_saved_object_key\": \"workflows/projects/{project_id}/applications/opencv-process-save-image-app/application.json\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
