  "item": [
    {
      "name": "Save Template",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/workflows/projects/{{projectId}}/templates/opencv-process-save-image-template/versions/1.0.0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "workflows",
            "projects",
            "{{projectId}}",
            "templates",
            "opencv-process-save-image-template",
            "versions",
            "1.0.0"
          ]
        },
        "description": "保存 opencv_process_save_image 的 workflow template。",
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"template\": {\r\n    \"format_id\": \"amvision.workflow-graph-template.v1\",\r\n    \"template_id\": \"opencv-process-save-image-template\",\r\n    \"template_version\": \"1.0.0\",\r\n    \"display_name\": \"OpenCV Process Save Image Template\",\r\n    \"description\": \"接收 base64 图片，执行一组 OpenCV 处理步骤，把结果保存到本地磁盘并返回保存后的图片响应。\",\r\n    \"nodes\": [\r\n      {\r\n        \"node_id\": \"decode_request_image\",\r\n        \"node_type_id\": \"core.io.image-base64-decode\",\r\n        \"parameters\": {}\r\n      },\r\n      {\r\n        \"node_id\": \"blur_image\",\r\n        \"node_type_id\": \"custom.opencv.gaussian-blur\",\r\n        \"parameters\": {\r\n          \"kernel_size\": 5,\r\n          \"sigma_x\": 1.2\r\n        }\r\n      },\r\n      {\r\n        \"node_id\": \"threshold_image\",\r\n        \"node_type_id\": \"custom.opencv.binary-threshold\",\r\n        \"parameters\": {\r\n          \"threshold\": 96,\r\n          \"max_value\": 255\r\n        }\r\n      },\r\n      {\r\n        \"node_id\": \"edge_image\",\r\n        \"node_type_id\": \"custom.opencv.canny\",\r\n        \"parameters\": {\r\n          \"threshold1\": 60,\r\n          \"threshold2\": 160,\r\n          \"aperture_size\": 3,\r\n          \"l2_gradient\": false\r\n        }\r\n      },\r\n      {\r\n        \"node_id\": \"save_image\",\r\n        \"node_type_id\": \"core.io.image-save\",\n        \"parameters\": {\n          \"save_directory\": \"{workflow_app_result_dir}\",\n          \"file_name\": \"{node_id}-{YYYYMMDDhhmmssSSS}.png\",\n          \"overwrite\": false\n        }\n      },\r\n      {\r\n        \"node_id\": \"preview_image\",\r\n        \"node_type_id\": \"core.output.image-body\",\r\n        \"parameters\": {\r\n          \"title\": \"Saved Edge Image\",\r\n          \"response_transport_mode\": \"storage-ref\"\r\n        }\r\n      },\r\n      {\r\n        \"node_id\": \"response\",\r\n        \"node_type_id\": \"core.output.http-response\",\r\n        \"parameters\": {\r\n          \"status_code\": 200\r\n        }\r\n      }\r\n    ],\r\n    \"edges\": [\r\n      {\r\n        \"edge_id\": \"edge-decode-blur\",\r\n        \"source_node_id\": \"decode_request_image\",\r\n        \"source_port\": \"image\",\r\n        \"target_node_id\": \"blur_image\",\r\n        \"target_port\": \"image\"\r\n      },\r\n      {\r\n        \"edge_id\": \"edge-blur-threshold\",\r\n        \"source_node_id\": \"blur_image\",\r\n        \"source_port\": \"image\",\r\n        \"target_node_id\": \"threshold_image\",\r\n        \"target_port\": \"image\"\r\n      },\r\n      {\r\n        \"edge_id\": \"edge-threshold-canny\",\r\n        \"source_node_id\": \"threshold_image\",\r\n        \"source_port\": \"image\",\r\n        \"target_node_id\": \"edge_image\",\r\n        \"target_port\": \"image\"\r\n      },\r\n      {\r\n        \"edge_id\": \"edge-canny-save\",\r\n        \"source_node_id\": \"edge_image\",\r\n        \"source_port\": \"image\",\r\n        \"target_node_id\": \"save_image\",\r\n        \"target_port\": \"image\"\r\n      },\r\n      {\r\n        \"edge_id\": \"edge-save-preview\",\r\n        \"source_node_id\": \"save_image\",\r\n        \"source_port\": \"image\",\r\n        \"target_node_id\": \"preview_image\",\r\n        \"target_port\": \"image\"\r\n      },\r\n      {\r\n        \"edge_id\": \"edge-preview-response\",\r\n        \"source_node_id\": \"preview_image\",\r\n        \"source_port\": \"body\",\r\n        \"target_node_id\": \"response\",\r\n        \"target_port\": \"body\"\r\n      }\r\n    ],\r\n    \"template_inputs\": [\r\n      {\r\n        \"input_id\": \"request_image_base64\",\r\n        \"display_name\": \"Request Image\",\r\n        \"payload_type_id\": \"image-base64.v1\",\r\n        \"target_node_id\": \"decode_request_image\",\r\n        \"target_port\": \"payload\"\r\n      }\r\n    ],\r\n    \"template_outputs\": [\r\n      {\r\n        \"output_id\": \"http_response\",\r\n        \"display_name\": \"HTTP Response\",\r\n        \"payload_type_id\": \"http-response.v1\",\r\n        \"source_node_id\": \"response\",\r\n        \"source_port\": \"response\"\r\n      }\r\n    ],\r\n    \"metadata\": {\r\n      \"example_kind\": \"opencv-process-save-image\",\r\n      \"node_groups\": {\r\n        \"input\": [\r\n          \"decode_request_image\"\r\n        ],\r\n        \"opencv_process\": [\r\n          \"blur_image\",\r\n          \"threshold_image\",\r\n          \"edge_image\"\r\n        ],\r\n        \"output\": [\r\n          \"save_image\",\r\n          \"preview_image\",\r\n          \"response\"\r\n        ]\r\n      }\r\n    }\r\n  }\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
