        "body": {
          "mode": "raw",
          "raw": "{\n  \"project_id\": \"project-1\",\n  \"application_ref\": {\n    \"application_id\": \"opencv-process-save-image-app\"\n  },\n  \"input_bindings\": {\n    \"request_image_base64\": {\n      \"image_base64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO5WZr8AAAAASUVORK5CYII=\",\n      \"media_type\": \"image/png\"\n    }\n  },\n  \"execution_metadata\": {\n    \"marker\": \"postman-workflow-example-documents-preview\",\n    \"example_name\": \"opencv_process_save_image\",\n    \"scenario\": \"opencv-process-save-image\",\n    \"trigger_source\": \"editor-preview\"\n  },\n  \"timeout_seconds\": 30\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
