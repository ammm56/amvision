{
  "$defs": {
    "CalibratedProfiles": {
      "additionalProperties": false,
      "description": "轮廓 X/高度已按 spatial 单位标定；扫描位置是独立物理量。",
      "properties": {
        "format_id": {
          "const": "amvision.calibrated-profiles.v1",
          "title": "Format Id",
          "type": "string"
        },
        "point_count": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Point Count",
          "type": "integer"
        },
        "profile_count": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "title": "Profile Count",
          "type": "integer"
        },
        "dtype": {
          "enum": [
            "float32",
            "float64"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "calibration_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Calibration Id",
          "type": "string"
        },
        "calibration_revision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Calibration Revision",
          "type": "string"
        },
        "spatial": {
          "$ref": "#/$defs/CloudSpatial"
        },
        "origin": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Origin",
          "type": "array"
        },
        "x_direction": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "X Direction",
          "type": "array"
        },
        "scan_direction": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Scan Direction",
          "type": "array"
        },
        "height_direction": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Height Direction",
          "type": "array"
        },
        "displacement": {
          "discriminator": {
            "mapping": {
              "encoder-positions": "#/$defs/EncoderProfilePositions",
              "fixed-step": "#/$defs/FixedProfileStep"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedProfileStep"
            },
            {
              "$ref": "#/$defs/EncoderProfilePositions"
            }
          ],
          "title": "Displacement"
        },
        "position_dtype": {
          "enum": [
            "float32",
            "float64"
          ],
          "title": "Position Dtype",
          "type": "string"
        }
      },
      "required": [
        "format_id",
        "point_count",
        "profile_count",
        "dtype",
        "calibration_id",
        "calibration_revision",
        "spatial",
        "origin",
        "x_direction",
        "scan_direction",
        "height_direction",
        "displacement",
        "position_dtype"
      ],
      "title": "CalibratedProfiles",
      "type": "object"
    },
    "CloudAxes": {
      "additionalProperties": false,
      "description": "轴语义声明；标签不是隐含的坐标变换。",
      "properties": {
        "handedness": {
          "enum": [
            "right",
            "left",
            "unknown"
          ],
          "title": "Handedness",
          "type": "string"
        },
        "axis_labels": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Axis Labels",
          "type": "array"
        },
        "definition_source": {
          "enum": [
            "metadata",
            "configuration",
            "unknown"
          ],
          "title": "Definition Source",
          "type": "string"
        }
      },
      "required": [
        "handedness",
        "axis_labels",
        "definition_source"
      ],
      "title": "CloudAxes",
      "type": "object"
    },
    "CloudSpatial": {
      "additionalProperties": false,
      "description": "点云长度单位、坐标系和轴定义。",
      "properties": {
        "length_unit": {
          "anyOf": [
            {
              "enum": [
                "m",
                "mm",
                "um"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Length Unit"
        },
        "unit_source": {
          "enum": [
            "metadata",
            "configuration",
            "unknown"
          ],
          "title": "Unit Source",
          "type": "string"
        },
        "frame_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Frame Id",
          "type": "string"
        },
        "axes": {
          "$ref": "#/$defs/CloudAxes"
        }
      },
      "required": [
        "length_unit",
        "unit_source",
        "frame_id",
        "axes"
      ],
      "title": "CloudSpatial",
      "type": "object"
    },
    "EncoderProfilePositions": {
      "additionalProperties": false,
      "description": "原编码器位置经显式尺度和零点换算，方向由 scan_direction 给定。",
      "properties": {
        "kind": {
          "const": "encoder-positions",
          "title": "Kind",
          "type": "string"
        },
        "dtype": {
          "enum": [
            "float32",
            "float64"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "scale": {
          "exclusiveMinimum": 0,
          "title": "Scale",
          "type": "number"
        },
        "origin": {
          "title": "Origin",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "dtype",
        "scale",
        "origin"
      ],
      "title": "EncoderProfilePositions",
      "type": "object"
    },
    "FixedProfileStep": {
      "additionalProperties": false,
      "description": "原采集行号对应位移；origin_line_id 的位置为扫描零点。",
      "properties": {
        "kind": {
          "const": "fixed-step",
          "title": "Kind",
          "type": "string"
        },
        "origin_line_id": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Origin Line Id",
          "type": "integer"
        },
        "step": {
          "exclusiveMinimum": 0,
          "title": "Step",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "origin_line_id",
        "step"
      ],
      "title": "FixedProfileStep",
      "type": "object"
    },
    "ProfileBufferDescriptor": {
      "additionalProperties": false,
      "description": "同机 little-endian 连续块，固定顺序、无 padding，标定由载荷固定。",
      "properties": {
        "format_id": {
          "const": "amvision.profile-buffer.v1",
          "title": "Format Id",
          "type": "string"
        },
        "profiles": {
          "$ref": "#/$defs/CalibratedProfiles"
        },
        "has_validity": {
          "title": "Has Validity",
          "type": "boolean"
        },
        "content_length": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000,
          "title": "Content Length",
          "type": "integer"
        }
      },
      "required": [
        "format_id",
        "profiles",
        "has_validity",
        "content_length"
      ],
      "title": "ProfileBufferDescriptor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "分配前固定轮廓、原始行表、标定和目标 binding。",
  "properties": {
    "format_id": {
      "const": "amvision.workflow-trigger-profile-prepare.v1",
      "default": "amvision.workflow-trigger-profile-prepare.v1",
      "title": "Format Id",
      "type": "string"
    },
    "trigger_source_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Trigger Source Id",
      "type": "string"
    },
    "event_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_payload_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Event Payload Key",
      "type": "string"
    },
    "profiles": {
      "$ref": "#/$defs/ProfileBufferDescriptor"
    }
  },
  "required": [
    "trigger_source_id",
    "event_id",
    "event_payload_key",
    "profiles"
  ],
  "title": "WorkflowTriggerProfilePrepareV1",
  "type": "object"
}
